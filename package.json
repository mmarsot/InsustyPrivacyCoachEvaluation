{
  "name": "insusty-review-bench",
  "version": "0.1.0",
  "private": true,
  "description": "Offline benchmark (dataset + runner + report) for the InsustyPromptCoach local AI review.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "tsx src/cli/validate.ts",
    "split": "tsx src/cli/split.ts",
    "ext": "tsx src/cli/ext.ts",
    "bench": "tsx src/cli/run.ts",
    "report": "tsx src/cli/report.ts",
    "compare": "tsx src/cli/compare.ts",
    "components": "tsx src/cli/components.ts",
    "dashboard": "tsx src/cli/dashboard.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"contract/**/*.ts\" \"src/**/*.{ts,html}\" \"tests/**/*.{ts,mjs}\" \"*.json\" \"*.js\" README.md AGENTS.md",
    "format:check": "prettier --check \"contract/**/*.ts\" \"src/**/*.{ts,html}\" \"tests/**/*.{ts,mjs}\" \"*.json\" \"*.js\" README.md AGENTS.md",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run knip && npm test",
    "test": "node --import tsx --test tests/*.test.ts",
    "lab": "tsx src/lab/cli.ts",
    "lab:classify": "tsx src/lab/classify-cli.ts",
    "ablate": "tsx src/lab/ablate.ts",
    "detbench": "tsx src/cli/detbench.ts",
    "docbench": "tsx src/cli/docbench.ts",
    "conformance": "tsx src/cli/conformance.ts",
    "literature": "tsx src/cli/literature.ts",
    "suite": "tsx src/cli/suite.ts",
    "parity": "tsx src/lab/request-parity.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "ajv": "^8.20.0",
    "esbuild": "^0.25.0",
    "hyparquet": "^1.31.4",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "globals": "^15.15.0",
    "knip": "^5.88.1",
    "pdf-lib": "1.17.1",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "onnxruntime-node": "npm:onnxruntime-web@1.22.0-dev.20250409-89f8206ba4"
  }
}
