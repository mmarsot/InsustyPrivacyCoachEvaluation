{
  "name": "insusty-review-bench",
  "version": "0.1.0",
  "private": true,
  "description": "Offline benchmark (dataset + runner + report) for the InsustyPromptCoach local AI review.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "tsx engine/cli/validate.ts",
    "split": "tsx datasets/insusty-custom/split.ts",
    "bench": "tsx engine/cli/bench.ts",
    "report": "tsx engine/cli/report.ts",
    "compare": "tsx engine/cli/compare.ts",
    "adapter": "tsx engine/cli/adapter.ts",
    "components": "tsx modules/insusty-privacy/tools/components.ts",
    "dashboard": "tsx dashboard/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"contract/**/*.ts\" \"modules/**/*.{ts,mjs,html}\" \"datasets/**/*.ts\" \"engine/**/*.ts\" \"dashboard/**/*.{ts,mjs,html}\" \"modules/*/manifest.json\" \"modules/*/dataset-adapters/*.json\" \"datasets/*/manifest.json\" \"datasets/*/contract.json\" \"*.json\" \"*.js\" README.md AGENTS.md",
    "format:check": "prettier --check \"contract/**/*.ts\" \"modules/**/*.{ts,mjs,html}\" \"datasets/**/*.ts\" \"engine/**/*.ts\" \"dashboard/**/*.{ts,mjs,html}\" \"modules/*/manifest.json\" \"modules/*/dataset-adapters/*.json\" \"datasets/*/manifest.json\" \"datasets/*/contract.json\" \"*.json\" \"*.js\" README.md AGENTS.md",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run knip && npm test",
    "test": "node --import tsx --test \"contract/**/*.test.ts\" \"modules/**/*.test.ts\" \"datasets/**/*.test.ts\" \"engine/**/*.test.ts\" \"dashboard/**/*.test.ts\"",
    "lab": "tsx modules/insusty-privacy/lab/cli.ts",
    "ablate": "tsx modules/insusty-privacy/lab/ablate.ts",
    "detbench": "tsx engine/cli/detbench.ts",
    "docbench": "tsx engine/cli/docbench.ts",
    "conformance": "tsx engine/cli/conformance.ts",
    "literature": "tsx engine/cli/literature.ts",
    "suite": "tsx engine/cli/suite.ts",
    "parity": "tsx modules/insusty-privacy/lab/request-parity.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "ajv": "^8.20.0",
    "esbuild": "^0.25.0",
    "hyparquet": "^1.31.4",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "globals": "^15.15.0",
    "knip": "^5.88.1",
    "pdf-lib": "1.17.1",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "onnxruntime-node": "npm:onnxruntime-web@1.22.0-dev.20250409-89f8206ba4"
  }
}
