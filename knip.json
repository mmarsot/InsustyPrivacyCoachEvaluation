{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "contract/*.ts",
    "engine/cli/*.ts",
    "engine/workers/*.ts",
    "dashboard/playground/host.ts",
    "dashboard/playground/*.fixture.mjs",
    "datasets/*/loader.ts",
    "modules/*/module.ts",
    "modules/insusty-privacy/lab/worker.ts",
    "modules/insusty-privacy/lab/browser/run.ts",
    "docs/readme-chart.ts",
    "**/*.test.ts"
  ],
  "project": [
    "contract/**/*.ts",
    "modules/**/*.{ts,mjs}",
    "datasets/**/*.ts",
    "engine/**/*.ts",
    "dashboard/**/*.{ts,mjs}",
    "docs/**/*.ts"
  ],
  "ignoreExportsUsedInFile": true
}
