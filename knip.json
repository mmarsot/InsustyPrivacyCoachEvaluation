{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "contract/*.ts",
    "src/cli/*.ts",
    "src/run/worker.ts",
    "src/lab/worker.ts",
    "src/lab/classify-worker.ts",
    "src/docbench/worker.ts",
    "src/playground/host.ts",
    "tests/**/*.test.ts",
    "tests/fixtures/*.mjs",
    "src/lab/browser/run.ts",
    "src/lab/candidates-coverage.ts",
    "src/lab/parity.ts"
  ],
  "project": ["contract/**/*.ts", "src/**/*.ts", "tests/**/*.{ts,mjs}"],
  "ignoreExportsUsedInFile": true
}
